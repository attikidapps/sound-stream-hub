/**
 * @summary Upload a new song with audio file (admin only)
 */
export const getUploadSongUrl = () => {
  return `/api/upload/song`;
};

export const uploadSong = async (
  uploadSongBody: UploadSongBody,
  options?: RequestInit,
): Promise<Song> => {
  const formData = new FormData();
  formData.append(`audio`, uploadSongBody.audio);
  formData.append(`title`, uploadSongBody.title);
  formData.append(`artist`, uploadSongBody.artist);
  formData.append(`genre`, uploadSongBody.genre);
  if (
    uploadSongBody.mixtapeId !== undefined &&
    uploadSongBody.mixtapeId !== null
  ) {
    formData.append(`mixtapeId`, uploadSongBody.mixtapeId);
  }
  if (
    uploadSongBody.trackNumber !== undefined &&
    uploadSongBody.trackNumber !== null
  ) {
    formData.append(`trackNumber`, uploadSongBody.trackNumber);
  }

  return customFetch<Song>(getUploadSongUrl(), {
    ...options,
    method: "POST",
    body: formData,
  });
};

